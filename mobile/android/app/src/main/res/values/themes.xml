<resources>
    <!-- Framework-only theme so the client has no third-party dependencies. -->
    <style name="Theme.Luduvo" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:colorPrimary">@color/luduvo_primary</item>
        <item name="android:colorPrimaryDark">@color/luduvo_primary_container</item>
        <item name="android:colorAccent">@color/luduvo_secondary</item>
        <item name="android:windowBackground">@color/luduvo_background</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:textColorPrimary">@color/luduvo_on_surface</item>
    </style>

    <style name="Theme.Luduvo.Fullscreen" parent="Theme.Luduvo">
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowActionBar">false</item>
        <item name="android:windowNoTitle">true</item>
    </style>

    <style name="Theme.Luduvo.Splash" parent="Theme.Luduvo.Fullscreen">
        <item name="android:windowBackground">@drawable/splash_background</item>
    </style>
</resources>
